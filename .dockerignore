# Version control
.git
.gitignore

# Node -- build-time only, never needed in the final image
node_modules
npm-debug.log

# Composer dev tooling / vendor from the host (installed fresh in-image)
vendor

# Never ship real environment files or local secrets into an image layer
.env
.env.*
!.env.example
auth.json

# Local databases
database/*.sqlite

# Tests -- not needed at runtime
tests
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# Logs, caches, framework-generated runtime state (rebuilt fresh per image)
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
bootstrap/cache/*.php

# IDE / editor
.idea
.vscode
.nova
.zed
.cursor
.phpactor.json

# Deployment/dev-only artifacts not needed inside the image
DEPLOYMENT.md
UAT_ISSUE_TEMPLATE.md
PROJECT_STATUS.md
CHANGELOG.md
MODULES.md
PRD.md
README.md
Deepseek.txt

# NOTE: app/Ai/DeepSeekAiProvider.php was excluded here while the DeepSeek
# integration was deliberately uncommitted, so it could never leak into an
# image. It is committed and shipped as of the DeepSeek provider commit, so
# excluding it now would strip the class out of the build context and the
# container would fail with `Class "App\Ai\DeepSeekAiProvider" not found`.
# Deepseek.txt (the raw API key file, above) stays excluded permanently.
